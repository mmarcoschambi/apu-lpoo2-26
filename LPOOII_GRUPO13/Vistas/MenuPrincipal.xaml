<Window x:Class="Vistas.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Mueblería - Menú Principal" 
        Height="550" Width="850" 
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="Images/fondo.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="#DD1E293B" Padding="10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Mueblería APU 2026" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,20,0"/>

                <Button x:Name="btnProveedores" Content="Proveedores" Click="btnProveedores_Click" Width="110" Height="32" Background="#334155" Foreground="White"/>
                <Button x:Name="btnClientes" Content="Clientes" Click="btnClientes_Click" Width="100" Height="32" Background="#334155" Foreground="White"/>
                <Button x:Name="btnProductos" Content="Productos" Click="btnProductos_Click" Width="100" Height="32" Background="#334155" Foreground="White"/>
                
                <!-- Solo habilitado para Admin -->
                <Button x:Name="btnVendedores" Content="Vendedores" Click="btnVendedores_Click" Width="110" Height="32" Background="#334155" Foreground="White"/>

                <Button x:Name="btnCerrarSesion" DockPanel.Dock="Right" Content="Cerrar Sesión" Click="btnCerrarSesion_Click" Width="110" Height="32" Background="#DC2626" Foreground="White"/>
            </DockPanel>
        </Border>

        <!-- Center Cards / Quick Launch -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="#CCFFFFFF" CornerRadius="12" Padding="25" MaxWidth="600">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Panel de Control General" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblInfoRol" Text="Sesión iniciada como: Admin" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                    <UniformGrid Columns="2" Rows="2" Margin="10">
                        <Button Content="ABM Proveedores" Click="btnProveedores_Click" Height="50" Margin="6" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="ABM Clientes" Click="btnClientes_Click" Height="50" Margin="6" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="ABM Productos" Click="btnProductos_Click" Height="50" Margin="6" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="btnCardVendedores" Content="ABM Vendedores (Solo Admin)" Click="btnVendedores_Click" Height="50" Margin="6" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#DD0F172A">
            <StatusBarItem>
                <TextBlock x:Name="lblStatusBar" Text="Estado: Conectado" Foreground="#CBD5E1" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="LPOO II - Grupo 13" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
