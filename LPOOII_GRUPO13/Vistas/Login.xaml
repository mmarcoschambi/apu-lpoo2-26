<Window x:Class="Vistas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenida al Sistema - Inicio de Sesión" 
        Height="320" Width="440" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="MUEBLERÍA - GESTIÓN" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="Ingrese sus credenciales de acceso" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Usuario:" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="txtUsuario" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="Contraseña:" FontWeight="SemiBold" Foreground="#334155"/>
                <PasswordBox x:Name="txtPassword" Height="28" Margin="0,4,0,6"/>

                <TextBlock Text="Usuarios demo: admin / admin (Admin) | vendedor / vendedor (Vendedor)" 
                           FontSize="10" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnSalir" Content="Salir" Width="90" Height="30" Click="btnSalir_Click" Background="#E2E8F0" Foreground="#1E293B"/>
            <Button x:Name="btnIngresar" Content="Ingresar" Width="100" Height="30" Click="btnclick_onClick" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
