<Window x:Class="Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mueblería - Grupo 13" Height="360" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sistema de Mueblería" FontSize="22"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,25"/>

        <StackPanel Grid.Row="1" Width="230">
            <Button Content="Alta de Proveedores" Height="35" Margin="3" Click="btnProveedores_Click"/>
            <Button Content="Alta de Clientes" Height="35" Margin="3" Click="btnClientes_Click"/>
            <Button Content="Alta de Productos" Height="35" Margin="3" Click="btnProductos_Click"/>
            <Button Content="Alta de Vendedores" Height="35" Margin="3" Click="btnVendedores_Click"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Salir" Width="90" Height="30"
                HorizontalAlignment="Right" Click="btnSalir_Click"/>
    </Grid>
</Window>
